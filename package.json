{
  "name": "furca",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "ALCHEMY_LOCAL_STATE=1 alchemy dev packages/infra/alchemy.run.ts",
    "deploy": "alchemy deploy packages/infra/alchemy.run.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "db:generate": "bun run --filter @furca/database db:generate",
    "check": "bun run typecheck && bun test",
    "postinstall": "effect-tsgo patch"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:",
