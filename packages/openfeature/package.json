{
  "name": "@furca/openfeature",
  "version": "0.1.0",
  "description": "OpenFeature providers (web and server) for furca",
  "keywords": [
    "feature-flags",
    "openfeature",
    "openfeature-provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxsdev/furca.git",
    "directory": "packages/openfeature"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@furca/sdk": "workspace:^",
    "@openfeature/web-sdk": "^1.10.0",
    "@openfeature/server-sdk": "^1.23.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/web-sdk": {
      "optional": true
    },
    "@openfeature/server-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@furca/sdk": "workspace:*",
    "@openfeature/core": "catalog:",
    "@openfeature/server-sdk": "catalog:",
    "@openfeature/web-sdk": "catalog:"
  }
}
