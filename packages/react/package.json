{
  "name": "@furca/react",
  "version": "0.1.0",
  "description": "React bindings for the furca feature flag & A/B testing SDK",
  "keywords": [
    "feature-flags",
    "ab-testing",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxsdev/furca.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@furca/sdk": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@furca/sdk": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
